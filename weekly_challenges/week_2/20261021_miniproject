import numpy as np

def simulate_velocity(dt, n_steps):
    """return NumPy arrays of times and velocities"""
    v = 0
    t = 0
    dv = 9.8 #m*s^-2
    count = 0
    velocities = np.array([])
    times = np.array([])
    while count <= n_steps:
        velocities = np.append(velocities, v)
        times = np.append(times, t)
        v += dv*dt
        t += dt
        count += 1
    return velocities, times

v, t = simulate_velocity(0.1, 20)
